# Postgres (required in production). If unset, local/dev uses in-memory PGLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. If set, GET /api/sync requires Authorization: Bearer <secret>
# Vercel Cron sends this automatically when the env var is named CRON_SECRET.
# CRON_SECRET=change-me
